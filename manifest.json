{
    "manifest_version": 3,
    "name": "BEC Email Analyzer",
    "version": "1.0.0",
    "description": "Detects suspicious Business Email Compromise patterns.",

    "permissions": [
        "activeTab",
        "scripting"
    ],

    "host_permissions": [
        "http://127.0.0.1:5000/*",
        "http://localhost:5000/*"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}